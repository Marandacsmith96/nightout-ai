# ===== NightOut AI — backend environment =====
# Copy this file to `.env` and fill in the keys you have.
# NEVER commit the real `.env` (it is git-ignored).

# --- AI (OpenAI API or any OpenAI-compatible endpoint) ---
# The class endpoint (OpenAI-compatible) works here too:
#   OPENAI_BASE_URL=http://dobolyi.com:9000/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Google Places API (real venue retrieval) ---
# Leave empty to run in DEMO MODE (sample places, clearly labeled).
GOOGLE_PLACES_API_KEY=

# --- Google Routes API (travel time / distance between stops) ---
GOOGLE_ROUTES_API_KEY=

# --- Ticketmaster Discovery API (optional: concerts, comedy, events) ---
TICKETMASTER_API_KEY=

# --- Frontend origin(s) allowed by CORS (comma-separated) ---
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
